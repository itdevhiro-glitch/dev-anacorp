rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function signed(){ return request.auth != null; }
  function profile(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
  function bootstrapRoot(){ return signed() && request.auth.token.email == 'root@ana.studio' && profile().role == 'root'; }
  function admin(){ return signed() && (profile().role == 'admin' || bootstrapRoot()); }
  function perm(p){ return signed() && (admin() || p in profile().permissions); }
  function project(pid){ return get(/databases/$(database)/documents/projects/$(pid)).data; }
  function projectRead(p){ return admin() || perm('projects.view.all') || p.picUserId == request.auth.uid || request.auth.uid in p.staffAssigneeIds || request.auth.uid in p.vendorUids || request.auth.uid in p.talentUids; }
  match /users/{uid} {
    allow read: if signed() && (
      uid == request.auth.uid ||
      (request.auth.token.email != null && request.auth.token.email == 'root@ana.studio') ||
      admin() || perm('projects.create') || perm('users.view')
    );
    allow create: if signed()
      && uid == request.auth.uid
      && request.auth.token.email != null
      && request.auth.token.email == 'root@ana.studio'
      && request.resource.data.email == 'root@ana.studio'
      && request.resource.data.role == 'root'
      && request.resource.data.status == 'active'
      && request.resource.data.bootstrapRoot == true
      && request.resource.data.createdBy == request.auth.uid;
    allow update, delete: if bootstrapRoot();
  }
  match /roles/{id} { allow read: if signed(); allow write: if bootstrapRoot(); }
  match /projects/{pid} {
    allow read: if signed() && projectRead(resource.data);
    allow create: if perm('projects.create') && request.resource.data.picUserId is string && request.resource.data.primaryAssigneeUid is string && request.resource.data.vendorId is string && request.resource.data.acceptanceStatus == 'pending';
    allow update: if signed() && (
      perm('projects.edit.core') || resource.data.picUserId == request.auth.uid ||
      (resource.data.primaryAssigneeUid == request.auth.uid && request.resource.data.primaryAssigneeUid == resource.data.primaryAssigneeUid && request.resource.data.picUserId == resource.data.picUserId && request.resource.data.vendorId == resource.data.vendorId)
    );
    allow delete: if bootstrapRoot();
    match /tasks/{id} { allow read: if signed() && projectRead(project(pid)); allow write: if signed() && (perm('tasks.manage') || request.auth.uid in project(pid).vendorUids); }
    match /submissions/{id} { allow read: if signed() && projectRead(project(pid)); allow create: if signed() && (perm('submissions.create') || request.auth.uid in project(pid).vendorUids); allow update: if perm('projects.review'); allow delete: if bootstrapRoot(); }
    match /revisions/{id} { allow read: if signed() && projectRead(project(pid)); allow create,update: if perm('projects.review'); allow delete: if bootstrapRoot(); }
  }
  match /vendors/{id} { allow read: if signed() && (perm('vendors.view') || resource.data.linkedUid == request.auth.uid); allow write: if perm('vendors.edit'); }
  match /vendorPrivate/{id} { allow read,write: if perm('vendors.finance.view'); }
  match /staff/{id} { allow read: if signed() && perm('staff.view'); allow write: if admin(); }
  match /talents/{id} { allow read: if signed() && perm('talents.view'); allow write: if perm('talents.edit'); }
  match /events/{id} { allow read: if signed(); allow create,update: if perm('events.create'); allow delete: if admin(); }
  match /auditEvents/{id} { allow read: if perm('audit.view'); allow create: if signed(); allow update,delete: if false; }

  match /financeTransactions/{id} {
    allow read: if signed() && (admin() || perm('finance.view') || resource.data.vendorUid == request.auth.uid);
    allow create: if signed() && (admin() || perm('finance.manage') || (request.resource.data.vendorUid == request.auth.uid && request.resource.data.sourceType == 'Vendor Project'));
    allow update: if admin() || perm('finance.manage');
    allow delete: if bootstrapRoot();
  }
  match /invoices/{id} {
    allow read: if signed() && (admin() || perm('finance.view') || resource.data.vendorUid == request.auth.uid);
    allow create: if signed() && request.resource.data.vendorUid == request.auth.uid && request.resource.data.createdBy == request.auth.uid && request.resource.data.status == 'Submitted';
    allow update: if admin() || perm('finance.manage');
    allow delete: if bootstrapRoot();
  }
  match /assets/{id} { allow read: if signed() && (admin() || perm('finance.view')); allow write: if admin() || perm('finance.manage'); }
  match /payroll/{id} { allow read: if signed() && (admin() || perm('finance.view')); allow write: if admin() || perm('finance.manage'); }

  match /categories/{id} { allow read: if signed(); allow write: if admin(); }
  match /settings/{id} { allow read: if signed(); allow write: if admin(); }
}}
