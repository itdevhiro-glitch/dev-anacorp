{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online','lastSeen'])"
      }
    },
    "live": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
